cat populated_places.geojson| jq '{
  type: "FeatureCollection",
  features: (.features | map({
    type: "Feature",
    properties: {
      name: .properties.NAME,
      latitude: .properties.LATITUDE,
      longitude: .properties.LONGITUDE,
      region: .properties.SOV0NAME
    }
  }))
}
' > cities.geojson
